# Neon Postgres (pooled URL for the app, direct URL for migrations)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_DIRECT=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=verify-full

# MCP server identity. Preferred: a connection token from the web app's "Connected apps" page.
AURA_TOKEN=
# Dev fallback when no token is set.
AURA_USER_ID=
